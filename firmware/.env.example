# Copy to firmware/.env (gitignored) and fill in. Values become string macros
# at build time via load_env.py. This repo is public: real addresses and
# credentials only ever go in .env, never in tracked files.

# Bluetooth address of the A2DP speaker to stream to (bttest env).
BT_SINK_ADDR=aa:bb:cc:dd:ee:ff

# Wi-Fi (app env): IoT SSID first, main SSID as fallback, same password.
WIFI_SSID=your-iot-ssid
WIFI_SSID_FALLBACK=your-main-ssid
WIFI_PASSWORD=your-wifi-password

# OTA push password (app/app_ota) and the device's IP for app_ota uploads.
OTA_PASSWORD=generate-a-long-random-string
NOISE_IP=192.168.x.y
